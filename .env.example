# Variáveis do frontend (Next.js). Copie para .env.local no desenvolvimento local.
# Só variáveis com prefixo NEXT_PUBLIC_ chegam ao navegador.

# URL do backend (sem barra final).
# Local: http://localhost:8000 | Produção: https://seu-backend.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Client ID (https://console.cloud.google.com/apis/credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=

# --- Login por cookie httpOnly (opcional, recomendado em produção) ---
# 1) No Vercel defina BACKEND_URL=https://seu-backend.railway.app (o Next faz proxy de /api)
# 2) Deixe NEXT_PUBLIC_API_URL vazio
# 3) Defina NEXT_PUBLIC_AUTH_MODE=cookie
# Sem isto o app segue no modo antigo: token no localStorage + cabeçalho Authorization.
NEXT_PUBLIC_AUTH_MODE=
BACKEND_URL=
